---
---

<section id="top" class="relative  bg-ink">
  <div class="grid min-h-[92vh] grid-cols-1 lg:min-h-screen lg:grid-cols-[1.05fr_1fr]">
    <!-- Text column -->
    <div class="section-pad relative z-10 flex flex-col justify-center gap-8 py-40 lg:py-32">
      <div data-reveal>
        <p class="eyebrow text-brass-300">F/2.8 &middot; 35mm &middot; Available Worldwide</p>
      </div>

      <div data-reveal style="transition-delay: 80ms;">
        <h1 class="text-5xl leading-[1.05] text-stone-50 sm:text-6xl xl:text-7xl">
          Hello, I&rsquo;m
          <span class="block italic text-brass-300">Julian Voss</span>
        </h1>
        <p class="mt-5 font-mono text-xs uppercase tracking-widest2 text-stone-400">
          Editorial &amp; Documentary Photographer
        </p>
      </div>

      <p
        data-reveal
        style="transition-delay: 160ms;"
        class="max-w-md text-base leading-relaxed text-stone-300"
      >
        For twelve years I&rsquo;ve chased light across six continents &mdash;
        from fog-locked valleys to glass-walled cities &mdash; building a
        practice around patience, honest portraiture and the kind of images
        that hold up on a gallery wall.
      </p>

      <div data-reveal style="transition-delay: 240ms;" class="flex flex-wrap items-center gap-5">
        <a href="#gallery" class="btn-primary">
          View my work
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="#about" class="text-sm font-medium text-stone-300 underline decoration-brass-400/60 decoration-2 underline-offset-4 transition-colors hover:text-stone-50">
          More about Julian
        </a>
      </div>

      <div data-reveal style="transition-delay: 320ms;" class="mt-6 flex gap-4 border-t border-white/10 pt-8">
        <div>
          <p class="font-display text-xl md:text-3xl text-stone-50">12<span class="text-brass-300">+</span></p>
          <p class="mt-1 font-mono text-[11px] uppercase tracking-widest2 text-stone-400">Years shooting</p>
        </div>
        <div>
          <p class="font-display text-xl md:text-3xl text-stone-50">46</p>
          <p class="mt-1 font-mono text-[11px] uppercase tracking-widest2 text-stone-400">Countries covered</p>
        </div>
        <div>
          <p class="font-display text-xl md:text-3xl text-stone-50">120<span class="text-brass-300">+</span></p>
          <p class="mt-1 font-mono text-[11px] uppercase tracking-widest2 text-stone-400">Editorial features</p>
        </div>
      </div>
    </div>

    <!-- Image column -->
    <div class="relative min-h-[50vh] lg:min-h-full  ">
      <img
        src="/images/hero-photographer.png"
        alt="Julian Voss standing on a ridge overlooking a misty valley, camera in hand"
        class="h-full w-full object-none object-[-900px_-100px] md:object-[75%_0px]"
        loading="eager"
      />
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-ink via-ink/10 to-transparent lg:hidden"></div>
      <div class="pointer-events-none absolute inset-y-0 left-0 hidden w-32 bg-gradient-to-r from-ink to-transparent lg:block"></div>
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-ink/60 to-transparent"></div>
    </div>
  </div>

  <div class="pointer-events-none absolute -left-24 top-1/3 h-72 w-72 rounded-full bg-brass-500/10 blur-3xl"></div>
</section>
