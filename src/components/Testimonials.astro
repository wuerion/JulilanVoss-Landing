---
const testimonials = [
  {
    quote:
      'Julian spent the first hour of our shoot just talking with the team before he ever raised the camera. The portraits felt like us — not a stock version of us.',
    name: 'Elena Marchetti',
    role: 'Creative Director, Nordvik Studio',
    img: '/images/testimonial-01.png',
  },
  {
    quote:
      'We hired him for a two-day product story and he came back with far more than we asked for — including three frames we ended up building an entire campaign around.',
    name: 'Marcus Webb',
    role: 'Brand Lead, Foundry Goods',
    img: '/images/testimonial-02.png',
  },
  {
    quote:
      'What stood out was the patience. He waited forty minutes for a single cloud to move for our rooftop shoot. That frame is still the one people ask about.',
    name: 'Theo Lindqvist',
    role: 'Editor, Field Notes Magazine',
    img: '/images/testimonial-03.png',
  },
];
---

<section id="testimonials" class="section-pad bg-ink py-24 text-stone-50 lg:py-32">
  <div class="mx-auto max-w-content">
    <div data-reveal class="max-w-lg">
      <p class="eyebrow text-brass-300">Testimonials</p>
      <h2 class="mt-5 text-4xl leading-tight sm:text-5xl">
        A few words from people I&rsquo;ve worked with.
      </h2>
    </div>

    <div class="mt-16 space-y-6">
      {
        testimonials.map((t, i) => (
          <div
            data-reveal
            style={`transition-delay: ${i * 100}ms;`}
            class={`flex flex-col items-start gap-8 rounded-[2rem] border border-white/10 bg-white/[0.03] p-8 sm:p-10 md:flex-row md:items-center ${
              i % 2 === 1 ? 'md:flex-row-reverse' : ''
            }`}
          >
            <img
              src={t.img}
              alt={t.name}
              class="h-24 w-24 shrink-0 rounded-2xl object-cover shadow-soft md:h-28 md:w-28"
              loading="lazy"
            />
            <div>
              <svg xmlns="http://www.w3.org/2000/svg" class="mb-4 h-6 w-6 text-brass-400" viewBox="0 0 24 24" fill="currentColor">
                <path d="M7.17 6C4.87 8.13 3.5 10.68 3.5 13.5c0 2.9 1.9 4.5 4 4.5 1.9 0 3.5-1.5 3.5-3.5 0-1.9-1.5-3.4-3.4-3.4-.3 0-.6 0-.9.1.3-1.7 1.7-3.4 3.5-4.7L7.17 6zm10 0c-2.3 2.13-3.67 4.68-3.67 7.5 0 2.9 1.9 4.5 4 4.5 1.9 0 3.5-1.5 3.5-3.5 0-1.9-1.5-3.4-3.4-3.4-.3 0-.6 0-.9.1.3-1.7 1.7-3.4 3.5-4.7L17.17 6z" />
              </svg>
              <p class="max-w-xl text-lg leading-relaxed text-stone-200">
                {t.quote}
              </p>
              <p class="mt-5 font-mono text-[11px] uppercase tracking-widest2 text-stone-400">
                {t.name} &middot; {t.role}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
