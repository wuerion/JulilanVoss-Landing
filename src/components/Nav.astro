---
const links = [
  { href: '#about', label: 'About' },
  { href: '#studies', label: 'Studies' },
  { href: '#gallery', label: 'Gallery' },
  { href: '#testimonials', label: 'Testimonials' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="absolute inset-x-0 top-0 z-50">
  <div class="section-pad pt-6">
    <nav
      class="mx-auto flex max-w-content items-center justify-between rounded-full border border-white/15 bg-ink/40 px-6 py-3.5 backdrop-blur-md sm:px-8"
    >
      <a href="#top" class="font-display text-lg tracking-wide text-stone-50">
        Julian <span class="text-brass-400 italic">Voss</span>
      </a>

      <ul class="hidden items-center gap-9 lg:flex">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm font-medium text-stone-200/90 transition-colors hover:text-brass-300"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href="#contact"
        class="hidden rounded-full bg-stone-50 px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:bg-brass-400 lg:inline-block"
      >
        Book a session
      </a>

      <button
        id="menu-toggle"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/20 text-stone-50 lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </nav>

    <div
      id="mobile-menu"
      class="mx-auto hidden max-w-content flex-col gap-1 rounded-3xl border border-white/15 bg-ink/90 p-4 backdrop-blur-md lg:hidden"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-xl px-4 py-3 text-sm font-medium text-stone-100 transition-colors hover:bg-white/5 hover:text-brass-300"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="#contact"
        class="mt-2 rounded-xl bg-stone-50 px-4 py-3 text-center text-sm font-medium text-ink"
      >
        Book a session
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!!isHidden));
  });

  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    })
  );
</script>
